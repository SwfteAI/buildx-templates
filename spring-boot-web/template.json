{
  "id": "spring-boot-web",
  "framework": "SPRING_BOOT",
  "displayName": "Spring Boot 3.4 + Java 21 + Maven",
  "version": "1.0.0",
  "engines": { "java": ">=21", "maven": ">=3.9" },
  "placeholders": ["APP_NAME", "APP_DESCRIPTION"],
  "postScaffold": [],
  "devCommand": "./mvnw spring-boot:run",
  "buildCommand": "./mvnw -B -DskipTests package",
  "typecheckCommand": "./mvnw -B -q -DskipTests compile",
  "previewPort": 8080
}
