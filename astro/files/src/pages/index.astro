---
import Layout from "../layouts/Layout.astro";
---
<Layout title="{{APP_NAME}}" description="{{APP_DESCRIPTION}}">
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 p-8">
    <h1 class="text-4xl font-semibold tracking-tight">Hello {{APP_NAME}}</h1>
    <p class="max-w-xl text-center text-slate-600">{{APP_DESCRIPTION}}</p>
  </main>
</Layout>
