{
  "id": "sveltekit",
  "framework": "SVELTEKIT",
  "displayName": "SvelteKit 2 + TypeScript + Tailwind",
  "version": "1.0.0",
  "engines": { "node": ">=20" },
  "placeholders": ["APP_NAME", "APP_DESCRIPTION"],
  "postScaffold": ["npm install"],
  "devCommand": "npm run dev -- --host 0.0.0.0",
  "buildCommand": "npm run build",
  "typecheckCommand": "npm run check",
  "previewPort": 5173
}
